# 当前使用的 TTS 引擎（可插拔，见 src/providers/）
TTS_PROVIDER=mimo

# 小米 MiMo API Key：到 platform.xiaomimimo.com 控制台获取，勿提交到仓库
MIMO_API_KEY=

# 默认音色（mimo-v2.5-tts 精品音色：茉莉/冰糖/苏打/白桦/Mia/Chloe/Milo/Dean）
MIMO_VOICE=茉莉

# Web 服务端口
PORT=5666

# LLM（OpenAI 兼容）配置：用于自动语气功能（自动拆解分段并逐段生成语气指令）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 自动语气开关（依赖上面三项 LLM 配置齐备）
AUTO_STYLE_ENABLED=false