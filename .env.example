# 当前使用的 TTS 引擎（可插拔，见 src/providers/）
TTS_PROVIDER=mimo

# 小米 MiMo API Key：到 platform.xiaomimimo.com 控制台获取，勿提交到仓库
MIMO_API_KEY=

# 默认音色（mimo-v2.5-tts 精品音色：茉莉/冰糖/苏打/白桦/Mia/Chloe/Milo/Dean）
MIMO_VOICE=茉莉

# Web 服务端口
PORT=5666

# LLM（OpenAI 兼容）配置：用于自动语气功能（自动拆解分段并逐段生成语气指令）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 自动语气开关（依赖上面三项 LLM 配置齐备）
AUTO_STYLE_ENABLED=false

# ===== 失败自动重试 =====
# 只有「API 侧故障」（限流 429 / 超时 / 5xx / 响应为空）才重试；
# 本地原因（缺 Key、ffmpeg 未安装、文件读不到）直接判失败，不占用队列时间。

# 段级重试：单段合成失败就地重试，避免整章从头再来
# 总尝试次数（含首次）、退避基数、单次退避上限（毫秒）
TTS_SEG_ATTEMPTS=3
TTS_SEG_RETRY_BASE_MS=1500
TTS_SEG_RETRY_MAX_MS=15000

# 任务级重试：整章失败后重新排到队尾，等前面文件转完再试
# 总尝试次数（含首次；4 即最多重排队 3 次）、退避基数、单次退避上限（毫秒）
TTS_TASK_ATTEMPTS=4
TTS_TASK_RETRY_BASE_MS=15000
TTS_TASK_RETRY_MAX_MS=120000

# 单次 TTS 请求超时（毫秒）：接口偶发挂死时不能卡住整个队列
MIMO_TIMEOUT_MS=120000
